{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"version": 2,
	"builds": [
		{
			"src": "dist/vercel.js",
			"use": "@vercel/node",
			"config": {
				"includeFiles": [
					"src/app/templates/**/*.ejs"
				]
			}
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "dist/vercel.js"
		}
	],
	"crons": [
		{
			"path": "/api/cron/daily",
			"schedule": "0 15 * * *"
		}
	]
}