{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"version": 2,
	"builds": [
		{
			"src": "api/index.ts",
			"use": "@vercel/node",
			"config": {
				"includeFiles": ["src/app/templates/**/*.ejs"]
			}
		}
	],
	"routes": [{ "src": "/(.*)", "dest": "api/index.ts" }],
	"crons": [
		{
			"path": "/api/cron/daily",
			"schedule": "0 15 * * *"
		}
	]
}
