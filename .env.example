NODE_ENV=development
PORT=5000

# ================= PostgreSQL (Prisma) =================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/housing_roommate?schema=public"

# ================= JWT =================
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# ================= App URLs =================
# Used to build absolute links back to this API (payment callbacks, etc).
BACKEND_URL=http://localhost:5000

# Allowed CORS origin for the browser client.
FRONTEND_URL=http://localhost:3000

# ================= GCP OAuth (Social Login) =================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ================= Redis (Upstash / Redis Cloud) =================
REDIS_USER=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

# ================= Nodemailer (Gmail SMTP) =================
SMTP_USER=your-email@gmail.com
EMAIL_SENDER="Housing & Roommate <your-email@gmail.com>"
SMTP_PASSWORD=your-gmail-app-password

# ================= Cloudinary =================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ================= bKash (Sandbox Tokenized Checkout) =================
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-sandbox-username
BKASH_PASSWORD=your-bkash-sandbox-password
BKASH_APP_KEY=your-bkash-sandbox-app-key
BKASH_APP_SECRET=your-bkash-sandbox-app-secret
# Payment callback is mounted under /api/v1 (see BKASH_CALLBACK_URL + route paths)
BKASH_CALLBACK_URL=http://localhost:5000/api/v1

# ================= Demo Accounts (Seeded on startup) =================
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@housing.com
SUPER_ADMIN_PASSWORD=Admin@1234

TESTER_ADMIN_NAME=Admin
TESTER_ADMIN_EMAIL=admin@housing.com
TESTER_ADMIN_PASSWORD=Admin@1234

TESTER_OWNER_NAME=Test Owner
TESTER_OWNER_EMAIL=owner@housing.com
TESTER_OWNER_PASSWORD=Owner@1234

TESTER_MANAGER_NAME=Test Manager
TESTER_MANAGER_EMAIL=manager@housing.com
TESTER_MANAGER_PASSWORD=Manager@1234

TESTER_TENANT_NAME=Test Tenant
TESTER_TENANT_EMAIL=tenant@housing.com
TESTER_TENANT_PASSWORD=Tenant@1234
