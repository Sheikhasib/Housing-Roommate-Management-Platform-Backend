<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="color-scheme" content="light dark">
	<meta name="supported-color-schemes" content="light dark">
	<title>New contact message — Neer</title>
	<style>
		body { margin: 0; padding: 0; word-spacing: normal; -webkit-text-size-adjust: 100%; }
		.preheader { display: none !important; visibility: hidden; opacity: 0; color: transparent; height: 0; width: 0; }
		@media (prefers-color-scheme: dark) {
			.email-canvas { background-color: #171410 !important; }
			.email-footer { color: #8b857b !important; }
		}
	</style>
</head>
<body class="email-canvas" style="margin:0;padding:0;background-color:#F4F1EA;">
	<span class="preheader" style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">A new message was submitted from the contact page.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</span>

	<% var receivedLabel = new Date(receivedAt).toUTCString(); %>

	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F4F1EA;">
		<tr>
			<td align="center" style="padding:40px 16px 48px;">

				<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:100%;background-color:#FFFFFF;border:1px solid #E9E3D7;border-radius:16px;overflow:hidden;">

					<tr>
						<td style="padding:26px 36px;background-color:#0F5B47;border-radius:16px 16px 0 0;">
							<table role="presentation" cellpadding="0" cellspacing="0" border="0">
								<tr>
									<td style="width:30px;height:30px;background-color:#FFFFFF;border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:14px;font-weight:800;color:#0F5B47;text-align:center;line-height:30px;">N</td>
									<td style="padding-left:11px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:15px;font-weight:700;color:#FFFFFF;letter-spacing:-0.1px;">Neer<span style="font-weight:400;color:#D5E6DF;">: Ashroy for your next home</span></td>
								</tr>
							</table>
						</td>
					</tr>
					<tr><td style="height:4px;background-color:#E8A33D;font-size:0;line-height:0;">&nbsp;</td></tr>

					<tr>
						<td style="padding:36px 36px 8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">

							<span style="display:inline-block;padding:6px 14px;background-color:#F0EDE6;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:#5B574E;">Contact</span>

							<h1 style="margin:22px 0 0;font-size:27px;line-height:1.25;font-weight:800;letter-spacing:-0.6px;color:#1B1712;">New contact message</h1>

							<p style="margin:16px 0 0;font-size:15px;line-height:1.65;color:#4A443C;">Someone used the public contact page. Reply directly to the email address below.</p>

							<div style="margin:24px 0 0;padding:18px 20px;background-color:#F8F5EF;border:1px solid #E9E3D7;border-radius:12px;">
								<div style="font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:#847C6F;">From</div>
								<div style="margin-top:6px;font-size:19px;font-weight:800;letter-spacing:-0.2px;color:#1B1712;"><%= name %></div>
								<div style="margin-top:4px;font-size:14px;line-height:1.6;color:#4A443C;"><a href="mailto:<%= email %>" style="color:#0F5B47;"><%= email %></a></div>

								<div style="margin-top:16px;font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:#847C6F;">Subject</div>
								<div style="margin-top:6px;font-size:15px;font-weight:700;color:#1B1712;"><%= subject %></div>

								<div style="margin-top:16px;font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:#847C6F;">Received</div>
								<div style="margin-top:6px;font-size:14px;color:#4A443C;"><%= receivedLabel %></div>
							</div>

							<div style="margin:18px 0 0;padding:18px 20px;background-color:#FFFFFF;border-left:3px solid #0F5B47;border-radius:0 10px 10px 0;font-size:15px;line-height:1.7;color:#1B1712;white-space:pre-wrap;word-break:break-word;"><%= message %></div>

						</td>
					</tr>

					<tr>
						<td class="email-footer" style="padding:28px 36px 32px;border-top:1px solid #E9E3D7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:12px;line-height:1.6;color:#A29A8C;">
							You're receiving this message because a visitor contacted the platform through the public contact form.<br>
							&copy; <%= year %> Neer. All rights reserved.
						</td>
					</tr>

				</table>

			</td>
		</tr>
	</table>
</body>
</html>