					"response": [],
					"description": "Owner token. Captures your first existing propertyId.",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.collectionVariables.set('accessToken', pm.collectionVariables.get('ownerAccessToken'));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"const j = pm.response.json();",
									"const arr = Array.isArray(j && j.data) ? j.data : [];",
									"if (arr.length && arr[0] && arr[0].id) {",
									"  pm.collectionVariables.set('propertyId', arr[0].id);",
									"  console.log('captured propertyId = ' + arr[0].id);",
									"} else { console.warn('No propertyId found (empty list?).'); }"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Create Property",
					"request": {
						"method": "POST",
						"header": [
