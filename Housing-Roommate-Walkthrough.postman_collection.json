		{
			"name": "Step 2 · Browse as a visitor (no token)",
			"item": [
				{
					"name": "Public Rooms (search/cache)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/room/public?page=1&limit=10&city=Dhaka&maxRent=20000&type=SHARED_ROOM",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"room",
								"public"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "city",
									"value": "Dhaka"
								},
								{
									"key": "maxRent",
									"value": "20000"
								},
								{
									"key": "type",
									"value": "SHARED_ROOM"
								}
							]
						},
						"description": ""
					},
					"response": [],
					"description": "Lists published shared rooms in Dhaka (Redis-cached). Captures the first available room as roomId. You may change the query filters.",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const j = pm.response.json();",
									"const arr = Array.isArray(j && j.data) ? j.data : [];",
									"const room = arr.find((r) => r.status === 'AVAILABLE' && r.isPublished) || arr[0];",
									"if (room && room.id) {",
									"  pm.collectionVariables.set('roomId', room.id);",
									"  console.log('roomId = ' + room.id);",
									"} else { console.warn('No published room found.'); }"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Public Rooms - Upcoming (rooms freeing up)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/room/public?availability=upcoming",
							"host": [
