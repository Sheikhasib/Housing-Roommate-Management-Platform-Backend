{
	"info": {
		"_postman_id": "housing-roommate-walkthrough",
		"name": "Housing & Roommate — Guided Walkthrough (run top to bottom)",
		"description": "An ordered, self-wiring demo of the whole platform. Steps 0-8 match docs/WALKTHROUGH.md. Role tokens and ids (roomId, propertyId, applicationId, viewingId, leaseId, invoiceId...) are captured automatically; step boundaries swap tokens for you.\n\nMoney note: deposits/invoices are completed on the gateway page in a browser (step 6 returns a paymentUrl). Until a deposit is paid there is no lease, so Step 7 items that need a lease will 4xx - that is the intended dependency.\n\nIMPORTANT: set base_url to the host only (e.g. http://localhost:5000). Do NOT include /api/v1 — every request path already contains it.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "tenantAccessToken",
			"value": ""
		},
