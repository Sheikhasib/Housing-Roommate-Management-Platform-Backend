				{
					"name": "Login - Tenant (demo)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							],
							"query": []
						},
						"description": "",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"tenant@housing.com\",\n    \"password\": \"Tenant@1234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"description": "Logs in the pre-verified tenant. Saves tenantAccessToken + accessToken automatically.",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const j = pm.response.json();",
									"if (j && j.data && j.data.accessToken) {",
									"  pm.collectionVariables.set('tenantAccessToken', j.data.accessToken);",
									"  pm.collectionVariables.set('accessToken', j.data.accessToken);",
									"  console.log('Tenant token captured');",
									"} else {",
									"  console.warn('No accessToken in response; cookies may be used instead.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
