							],
							"path": [
								"api",
								"v1",
								"room",
								"availability",
								":propertyId"
							]
						},
						"description": "Per-property vacancy board: summary (totalRooms, totalBeds, occupiedBeds, vacantBeds, occupancyRate, fullyVacantRooms, partiallyOccupiedRooms, fullRooms, maintenanceRooms, nextAvailableDate) + per-room rows with vacantBeds / availableNow / nextAvailableDate / upcomingReleaseDates. Counts and dates only (no tenant identities). OWNER (owns it), assigned PROPERTY_MANAGER, or ADMIN. Overwrite {{propertyId}} first (e.g. from My Properties)."
					},
					"response": [],
					"description": "undefined In this step {{propertyId}} was just captured by Create Property."
