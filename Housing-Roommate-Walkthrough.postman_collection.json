						"url": {
							"raw": "{{base_url}}/api/v1/property",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"property"
							],
							"query": []
						},
						"description": "latitude (-90..90) / longitude (-180..180) are optional map-pin coordinates (display only).",
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"title\": \"Green View Residence 2\",\n\t\"description\": \"Family apartment near Banani market.\",\n\t\"type\": \"APARTMENT\",\n\t\"city\": \"Dhaka\",\n\t\"area\": \"Banani\",\n\t\"address\": \"House 20, Road 7\",\n\t\"amenities\": [\n\t\t\"wifi\",\n\t\t\"lift\",\n\t\t\"parking\"\n\t],\n\t\"googleMapUrl\": \"https://maps.app.goo.gl/xxxx\",\n\t\"latitude\": 23.7925,\n\t\"longitude\": 90.4078\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"description": "Creates a NEW property and overwrites propertyId with it, so repeat runs always use a fresh listing.",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const j = pm.response.json();",
									"const obj = (j && j.data && !Array.isArray(j.data)) ? j.data : (Array.isArray(j.data) ? j.data[0] : null);",
									"if (obj && obj.id) {",
									"  pm.collectionVariables.set('propertyId', obj.id);",
									"  console.log('captured propertyId = ' + obj.id);",
									"} else { console.warn('No id in created response.'); }"
								],
								"type": "text/javascript"
							}
						}
					]
				},
