// Property delegation (spec 17). A ManagerProfile is a PROPERTY_MANAGER
// account's role profile; it never owns property. Access is granted per
// property through the PropertyManager join, assigned by the property's
// verified owner (CONTROL tier). Managers hold OPERATE-tier rights only.

model ManagerProfile {
  id String @id @default(uuid())

  name          String
  email         String    @unique
  contactNumber String?
  bio           String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  //relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assignments PropertyManager[]

  @@index([email], name: "idx_manager_email")
  @@index([isDeleted], name: "idx_manager_is_deleted")
  @@map("manager_profiles")
}

model PropertyManager {
  id         String   @id @default(uuid())
  assignedAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  managerId String
  manager   ManagerProfile @relation(fields: [managerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([propertyId, managerId], name: "unique_manager_per_property")
  @@index([managerId], name: "idx_property_manager_manager")
  @@map("property_managers")
}
