// OwnerProfile holds everything about a verified property owner/landlord.
// Just like a doctor in the reference project, an owner has to be approved by
// an admin before they can list properties on the platform.

model OwnerProfile {
  id String @id @default(cuid())

  name          String
  email         String    @unique
  contactNumber String?
  companyName   String?
  address       String?

  verificationStatus OwnerVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?

  // identity / proof-of-ownership documents uploaded during registration
  documents Json? // [{ url: String, publicId: String }]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  //relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  properties Property[]

  @@index([email], name: "idx_owner_email")
  @@index([verificationStatus], name: "idx_owner_verification_status")
  @@map("owner_profiles")
}
