// Notification = in-app alert pushed to a user whenever something important
// happens (application reviewed, payment received, maintenance updated, etc).

model Notification {
  id String @id @default(uuid())

  type    NotificationType @default(SYSTEM)
  title   String
  message String
  data    Json? // optional payload linked to the source entity

  isRead Boolean  @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, isRead], name: "idx_notification_user_read")
  @@map("notifications")
}
