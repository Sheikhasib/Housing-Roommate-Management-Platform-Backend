# =============================================================
# Vercel production environment template
# Live backend: https://housing-roommate-management-platform-backend.vercel.app
#
# How to use:
#   1. Vercel -> Project -> Settings -> Environment -> Add from .env
#   2. Pick this file
#   3. Replace every "your-..." / "..." placeholder with the real value
#   4. Redeploy
# =============================================================
NODE_ENV=production

# ---------------- PostgreSQL (hosted: Neon / Supabase / RDS) ----------------
DATABASE_URL="postgresql://user:password@your-hosted-postgres-host:5432/housing_roommate?sslmode=require"

# ---------------- JWT ----------------
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------------- App URLs (LIVE) ----------------
# Absolute links back to this API (payment callbacks, receipts, docs).
BACKEND_URL=https://housing-roommate-management-platform-backend.vercel.app

# CORS origin + post-payment redirects. Set to your deployed frontend.
FRONTEND_URL=https://your-frontend.vercel.app

# Used by SSLCommerz to build its return/IPN URLs (must be publicly reachable).
BACKEND_PUBLIC_URL=https://housing-roommate-management-platform-backend.vercel.app

# ---------------- GCP OAuth (Social Login) ----------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------------- Redis (hosted: Upstash / Redis Cloud) ----------------
REDIS_USER=default
REDIS_PASSWORD=your-upstash-redis-password
REDIS_HOST=your-upstash-redis-host.upstash.io
REDIS_PORT=6379

# ---------------- Nodemailer (Gmail SMTP) ----------------
SMTP_USER=your-email@gmail.com
EMAIL_SENDER="Housing & Roommate <your-email@gmail.com>"
SMTP_PASSWORD=your-gmail-app-password

# ---------------- Cloudinary ----------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------------- bKash ----------------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-sandbox-username
BKASH_PASSWORD=your-bkash-sandbox-password
BKASH_APP_KEY=your-bkash-sandbox-app-key
BKASH_APP_SECRET=your-bkash-sandbox-app-secret
# Callback is mounted under /api/v1/payment/callback
BKASH_CALLBACK_URL=https://housing-roommate-management-platform-backend.vercel.app/api/v1

# ---------------- SSLCommerz ----------------
SSL_COMMERZ_STORE_ID=your_sslcommerz_store_id_here
SSL_COMMERZ_STORE_PASSWORD=your_sslcommerz_store_password_here
SSLCOMMERZ_INIT_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATE_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# ---------------- Stripe (international payments) ----------------
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_CURRENCY=usd
STRIPE_BDT_TO_BASE=120

# ---------------- Vercel Cron guard ----------------
# Sent as `Authorization: Bearer <value>` to /api/cron/daily by Vercel Cron.
CRON_SECRET=replace-with-a-strong-random-secret

# ---------------- Demo Accounts (seeded with `npm run seed`) ----------------
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@housing.com
SUPER_ADMIN_PASSWORD=Admin@1234

TESTER_ADMIN_NAME=Admin
TESTER_ADMIN_EMAIL=admin@housing.com
TESTER_ADMIN_PASSWORD=Admin@1234

TESTER_OWNER_NAME=Test Owner
TESTER_OWNER_EMAIL=owner@housing.com
TESTER_OWNER_PASSWORD=Owner@1234

TESTER_MANAGER_NAME=Test Manager
TESTER_MANAGER_EMAIL=manager@housing.com
TESTER_MANAGER_PASSWORD=Manager@1234

TESTER_TENANT_NAME=Test Tenant
TESTER_TENANT_EMAIL=tenant@housing.com
TESTER_TENANT_PASSWORD=Tenant@1234
